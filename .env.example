# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure manually via the Secrets panel or your local .env file.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# VITE_LTA_DATAMALL_API_KEY: LTA DataMall AccountKey for real-time commercial/LTA carpark availability.
# Add your key manually in your environment variables / Secrets panel.
VITE_LTA_DATAMALL_API_KEY=""

# VITE_URA_ACCESS_KEY: URA API AccessKey for URA off-street & roadside carpark availability.
# Add your key manually in your environment variables / Secrets panel.
VITE_URA_ACCESS_KEY=""

# VITE_URA_TOKEN: Optional URA daily dynamic token (generated via URAAccessKey) if using direct client-side URA calls.
VITE_URA_TOKEN=""


